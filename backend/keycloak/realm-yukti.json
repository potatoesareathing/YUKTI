{
  "realm": "yukti",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "yukti-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
    }
  ],
  "users": [
    {
      "username": "analyst",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "analyst", "temporary": false }],
      "realmRoles": ["investigator"]
    }
  ],
  "roles": {
    "realm": [{ "name": "investigator" }, { "name": "admin" }]
  }
}
