DATABASE_URL=postgresql+psycopg2://yukti:yukti@localhost:5432/yukti
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=yuktipassword
MLFLOW_TRACKING_URI=http://localhost:5001
KEYCLOAK_ISSUER=http://localhost:8080/realms/yukti
KEYCLOAK_AUDIENCE=yukti-api
AUTH_BYPASS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000

# --- Natural-language assistant (POST /api/ask) -----------------------------
# The model receives the schema catalogue and the question only; never a row.
# See docs/ASSISTANT.md.
ASK_ENABLED=true
ASK_DEFAULT_SOURCE=local

# Default: a free local model via Ollama. No API key, no per-query cost, and
# nothing leaves the machine — which is what DATA-AND-MODELS.md requires.
#   ollama serve && ollama pull qwen2.5-coder:7b
ASK_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Alternative: any OpenAI-compatible endpoint — a free hosted tier, vLLM,
# LM Studio. Leave the key blank for a local server that does not want one.
# ASK_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Alternative: Claude. Paid.
# ASK_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ASK_EFFORT=medium

# --- Zoho Catalyst Data Store as a data source ------------------------------
# Leave blank to disable; /api/ask?source=local keeps working without them.
# The refresh token is a long-lived secret — keep it out of version control.
CATALYST_PROJECT_ID=
CATALYST_ENVIRONMENT_ID=
CATALYST_REFRESH_TOKEN=
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_DC=in
CATALYST_ENVIRONMENT=Development
